{
  "manifest_version": 3,
  "name": "OZON ERP Detail Sender",
  "version": "0.6.30",
  "description": "Collect OZON data, scan stores, and batch-complete sourcing tasks with pricing thresholds.",
  "permissions": ["storage", "unlimitedStorage", "activeTab", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://yehui1285-tech.github.io/ozon/*",
    "http://127.0.0.1:17628/*",
    "https://*.1688.com/*",
    "https://*.ozone.ru/*",
    "https://*.alicdn.com/*"
  ],
  "action": {
    "default_title": "OZON ERP Detail Sender",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yehui1285-tech.github.io/ozon/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["http://127.0.0.1:17628/*"],
      "js": ["pinduoduo-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.1688.com/*"],
      "js": ["1688-core.js", "1688-content.js"],
      "run_at": "document_idle"
    }
  ]
}
