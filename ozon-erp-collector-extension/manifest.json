{
  "manifest_version": 3,
  "name": "OZON ERP Detail Sender",
  "version": "0.6.11",
  "description": "Collect OZON pricing data with paired black-price lookup, plus resilient sequential store scanning, resume, auto-skip, and exports.",
  "permissions": ["storage", "activeTab", "tabs", "scripting", "alarms"],
  "host_permissions": [
    "https://www.ozon.ru/*",
    "https://yehui1285-tech.github.io/ozon/*"
  ],
  "action": {
    "default_title": "OZON ERP Detail Sender",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://yehui1285-tech.github.io/ozon/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
